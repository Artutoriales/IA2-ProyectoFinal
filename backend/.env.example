# Subir este valor reduce falsos positivos, pero puede omitir personas reales.
CONFIDENCE_THRESHOLD=0.50

# Modelo YOLO nano preentrenado en COCO (incluye la clase person).
MODEL_NAME=yolov8n.pt

# Tamaño máximo de imagen subida (MB).
MAX_UPLOAD_MB=10

# Orígenes permitidos para el frontend (Vite por defecto).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
